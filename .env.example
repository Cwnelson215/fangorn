# Database
export DB_HOST=localhost
export DB_PORT=5432
export DB_NAME=fangorn
export DB_USER=postgres
export DB_PASSWORD=postgres
# 'disable' for local docker-compose; 'require' against CloudNativePG (self-signed cert)
export DB_SSLMODE=disable

# App password (optional — if unset, auth is disabled)
# export APP_PASSWORD=your_password

# Scheduler: how often to post due recurring items and snapshot net worth,
# and how far ahead to project upcoming occurrences without posting them.
# export SCHEDULER_INTERVAL=5m
# export SCHEDULER_HORIZON_DAYS=60

# Investment prices: 'yahoo' (default, no key) or 'none'
# export QUOTES_PROVIDER=yahoo
# export QUOTES_MARKET_TTL=1m

# Receipt photos: 'anthropic' reads them with Claude; 'none' (default) stores
# them and leaves every receipt for you to enter by hand.
# export RECEIPTS_PROVIDER=anthropic
# export ANTHROPIC_API_KEY=sk-ant-...
# export RECEIPTS_MODEL=claude-opus-5
