# Published images are PUBLIC. Nothing secret may enter the build context —
# not even in an intermediate builder layer, which the GHA cache exports.
.git
.github
.vscode
.idea

# Secrets / credentials
.env
.env.*
!.env.example
teller/
client_secret*.json
*.pem
*.key

# Dependencies and build output
node_modules
frontend/node_modules
frontend/build
frontend/.svelte-kit
server

# Receipt photos are a family's purchases. Test fixtures are JSON only, and
# nothing that looks like a real photo may be baked into a public image.
**/testdata/**/*.jpg
**/testdata/**/*.jpeg
**/testdata/**/*.png
**/testdata/**/*.heic
**/testdata/**/*.webp
receipts-samples/

# Not compiled — see _deprecated/README.md
_deprecated/

# Infra + docs (not needed to build the binary)
index.ts
Pulumi*.yaml
tsconfig.json
docker-compose.yml
*.md
